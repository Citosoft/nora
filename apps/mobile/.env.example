# Clerk publishable key for the same Clerk instance Nora Desktop signs in with (pk_live_… / pk_test_…).
# When unset, the app shows a configuration message instead of the sign-in screen.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Control-plane Worker base URL. Defaults to https://remote-api.withnora.run when unset.
EXPO_PUBLIC_REMOTE_API_URL=
