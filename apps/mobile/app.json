{
  "expo": {
    "name": "Nora",
    "slug": "nora",
    "version": "0.1.0",
    "scheme": "nora",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D1410",
    "ios": {
      "bundleIdentifier": "run.withnora.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "run.withnora.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D1410",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Nora",
      "shortName": "Nora",
      "description": "Chat with your Nora agents, follow their progress and approve actions from your phone.",
      "lang": "en",
      "themeColor": "#0D1410",
      "backgroundColor": "#0D1410"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1410"
        }
      ],
      "expo-font"
    ],
    "owner": "citosoft",
    "extra": {
      "eas": {
        "projectId": "1211afdd-95ba-4d2b-bc7c-e4e980af97fd"
      }
    }
  }
}
