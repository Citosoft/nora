{
  "expo": {
    "name": "Nora",
    "slug": "nora",
    "owner": "citosoft",
    "version": "0.1.2",
    "scheme": "nora",
    "orientation": "default",
    "icon": "./assets/icon-ios.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.citosoft.nora",
      "icon": "./assets/icon-ios.png",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "run.withnora.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon-ios.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Nora",
      "shortName": "Nora",
      "description": "Chat with your Nora agents, follow their progress and approve actions from your phone.",
      "lang": "en",
      "themeColor": "#000000",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 102,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach to your Nora messages.",
          "cameraPermission": "Take photos to attach to your Nora messages.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#000000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1211afdd-95ba-4d2b-bc7c-e4e980af97fd"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1211afdd-95ba-4d2b-bc7c-e4e980af97fd"
    }
  }
}
